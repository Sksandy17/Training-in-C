//COUNT ALL THE FACTORS
//Without using square root in time complexity
//Only for sqrt
#include<stdio.h>
int main()
{
    int n, count = 0;
    scanf("%d", &n);
    for(int i = 1; i*i <= n; i++)
    {
        if(n % i == 0)
        {
            if(n / i == i)
            {
                count++;
            }
            else
            {
                count += 2;
            }
        }
    }
    printf("%d", count);
    return 0;
}

//Using squareroot in time complexity
//Only for non sqrt
#include<math.h>
#include<stdio.h>
int main()
{
    int n, count = 0;
    scanf("%d", &n);
    for(int i = 1; i <= sqrt(n); i++)
    {
        if(n % i == 0)
        {
            count += 2;
        }
    }
    printf("%d", count);
    return 0;
}

//Normal way
