}

//6.  COUNT ME 5(geeksforgeeks)
int countDigits(int n) {
    int count=0;
    while(n>0)
    {
        count++;
        n=n /= 10;
    }
    return count;
}

//7.  Maximum and Minimum Digit
#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    char n[100];
    int max=0, min=1000;
    scanf("%s", n);
    for(int i = 0; i<= strlen(n); i++)
    {
        if(n[i]>='0' && n[i]<='9')
        {
            int digit=n[i]-'0';
            if(digit>max)
                max=digit;
            if(digit<min)
                min=digit;
        }
    }
    printf("%d %d", max, min);
    return 0;
}

//8.  Reverse a Number(CodeChef)
#include <stdio.h>

int main() {
	int n;
	scanf("%d", &n);
	int rev=0;
	while(n>0)
	{
	    int r=n%10;
	    rev *= 10+r;
	    n /= 10;
	}
	printf("%d", rev);
	return 0;
}

//9.  Palindrome Number 119(LeetCode)
bool isPalindrome(int x) {
    
    int original_number = x;
    long long reversed_number =0;
    if(x<0){
        return false;
    }while(x!= 0){
        int remainder = x%10;
        reversed_number = reversed_number * 10 + remainder;
        x/=10;
    }return original_number == reversed_number;
}

