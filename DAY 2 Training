1.USING ARITHMETIC OPERATOR TO SWAPPING TWO NUMBERS WITHOUT USING THIRD VARIABLE

METHOD.1 
// C Code to swap two numbers using arithmetic operators
#include <stdio.h>
int main() {
    int a = 2, b = 3;
    printf("a = %d b = %d\n", a, b);   
  
    a = a + b;
    b = a - b;
    a = a - b;
  
    printf("a = %d b = %d\n", a, b);
    return 0;
}

METHOD.2
 // C Code to swap two numbers using bitwise XOR

#include <stdio.h>
int main() {
    int a = 2, b = 3;
    printf("a = %d b = %d\n", a, b);   
  
    a = a ^ b;
    b = a ^ b;
    a = a ^ b;
  
    printf("a = %d b = %d\n", a, b);
    return 0;
}

METHOD.3
//C Code to swap two numbers using multiply and division
#include <stdio.h>

int main() {
    int a = 10, b = 20;

    a = a * b;
    b = a / b;
    a = a / b;

    printf("a = %d, b = %d", a, b);
    return 0;
}

