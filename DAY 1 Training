//6.  To find the sum of digits of a number
#include <stdio.h>
int main()
{
    int num1, digit, sum;
    scanf("%d",&num1);
    while(num1>0)
    {
        digit = num1%10;
        sum = sum+digit;
        num1= num1/10;
    }
    printf("%d", sum);
    return 0;
}

