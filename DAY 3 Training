//10.  Is It a Prime Number? 1
#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int n, count = 0;
    scanf("%d", &n);
    for(int i = 1; i <= n; i++)
    {
        if(n % i == 0)
        {
            count++;
        }
    }
    if(count == 2)
    {
       printf("Prime");
    }
    else
    {
        printf("Not Prime");
    }
    return 0;
}

