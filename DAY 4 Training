//4.  NO OF COMMON FACTORS 1(LeetCode)
int commonFactors(int a, int b) {
    int count = 0;
    for(int i = 1; i<=a && i <= b; i++)
    {
        if(a % i == 0 && b % i == 0)
        {
            count++;
        }
    }
    return count;
}

//5.  THREE DIVISORS 3(LeetCode)
