//1.	Find the largest number among three using ternary operator.
#include<stdio.h>
int main()
{
    int a, b, c, greater;
    scanf("%d%d%d", &a, &b, &c);
    greater = ((a>b)?((a>c)? a : b) : ((b>c)? b : c));
    printf("%d", greater);
    return 0;
}
//2.	Find second largest number among three using ternary operator.
