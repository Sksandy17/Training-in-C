}

//Normal way a number is prime or not
//METHOD 1
#include<stdio.h>
int main()
{
    int n, count = 0;
    scanf("%d", &n);
    for(int i = 1; i <= n; i++)
    {
        if(n % i == 0)
        {
            count++;
        }
    }
    if(count == 2)
    {
       printf("Prime");
    }
    else
    {
        printf("Not a Prime");
    }

    return 0;
}

